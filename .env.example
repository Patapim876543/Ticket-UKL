# ─── Server ───────────────────────────────────────────────────────────────────
PORT=3000

# ─── Database MySQL ───────────────────────────────────────────────────────────
# Format: mysql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL="mysql://root:PASSWORD@localhost:3306/tiket_app"

# Untuk deploy (contoh Railway / PlanetScale / Clever Cloud):
# DATABASE_URL="mysql://user:pass@host:3306/tiket_app"

# ─── JWT ──────────────────────────────────────────────────────────────────────
JWT_SECRET=ganti_dengan_random_string_panjang_di_production
JWT_EXPIRES_IN=24h
